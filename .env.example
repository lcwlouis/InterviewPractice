# ── InterviewPractice environment configuration ──
# Copy this file to .env and fill in the values you need.

# Which LLM provider to use for interview simulation: openai | gemini
INTERVIEW_PROVIDER=openai

# OpenAI configuration
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Google Gemini configuration
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-pro

# Application logging level: DEBUG | INFO | WARNING | ERROR
APP_LOG_LEVEL=INFO

# Enable optional web research for interviewer names / company info.
# Requires a Tavily API key; set to true to activate.
ENABLE_WEB_RESEARCH=false

# Tavily API key for web research (https://tavily.com)
SEARCH_API_KEY=

# Default regional/culture preset for interviewer behaviour.
# Options: US | UK | CA | AU | DE | JP | IN | SG
DEFAULT_COUNTRY_PRESET=SG
